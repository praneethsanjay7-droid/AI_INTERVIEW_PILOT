<!DOCTYPE html>
<html>
<head>
    <title>Interview Pilot - Register</title>
</head>
<body>

    <h1>Create Account</h1>

    <form action="/register" method="POST">

        <input
            type="text"
            name="name"
            placeholder="Name"
            required
        >

        <br><br>

        <input
            type="email"
            name="email"
            placeholder="Email"
            required
        >

        <br><br>

        <input
            type="password"
            name="password"
            placeholder="Password"
            required
        >

        <br><br>

        <button type="submit">Register</button>

    </form>

    <br>

    <a href="/">Already have an account? Login</a>

</body>
</html>