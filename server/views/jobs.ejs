<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Hiring Roles - InterviewPilot</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/jobs.css">
</head>
<body>

    <!-- Global Navigation -->
    <header class="ip-navbar">
        <div class="ip-container ip-navbar-inner">
            <a href="/dashboard" class="ip-brand">
                <div class="ip-brand-icon">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                </div>
                <span>Interview<span class="ip-brand-accent">Pilot</span></span>
            </a>
            <nav style="display: flex; align-items: center; gap: 0.75rem;">
                <ul class="ip-nav-links">
                    <li><a href="/dashboard" class="ip-nav-link">Dashboard</a></li>
                    <li><a href="/jobs" class="ip-nav-link active">Hiring Roles</a></li>
                    <li><a href="/create-job" class="ip-nav-link">+ Create Role</a></li>
                </ul>

                <% 
                    const currentUser = typeof user !== 'undefined' && user ? user : null;
                    const isCandidate = currentUser && currentUser.role === 'candidate';
                    const roleLetter = isCandidate ? 'C' : 'I';
                    const avatarClass = isCandidate ? 'ip-avatar-candidate' : 'ip-avatar-interviewer';
                    const roleTitle = isCandidate ? (currentUser.name || 'Candidate') : (currentUser && currentUser.name ? currentUser.name : 'Interviewer');
                    const roleSub = isCandidate ? 'Candidate' : 'Interviewer';
                %>
                <div class="ip-user-profile-widget" title="Logged in as <%= roleSub %>">
                    <div class="ip-user-avatar <%= avatarClass %>">
                        <%= roleLetter %>
                    </div>
                    <div class="ip-user-meta-text">
                        <span class="ip-user-name"><%= roleTitle %></span>
                        <span class="ip-user-role-label"><%= roleSub %></span>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="ip-page-wrapper">
        <div class="ip-container">

            <div class="ip-page-header">
                <div class="ip-page-header-row">
                    <div>
                        <h1>My Hiring Roles</h1>
                        <p class="ip-page-subtitle">Manage open positions, review candidate pipelines, and schedule interviews</p>
                    </div>
                    <div>
                        <a href="/create-job" class="ip-btn ip-btn-primary">
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                            Create New Hiring Role
                        </a>
                    </div>
                </div>
            </div>

            <% if (!jobs || jobs.length === 0) { %>
                <div class="ip-empty-state">
                    <div class="ip-empty-icon">
                        <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <h3 class="ip-empty-title">No hiring roles created yet</h3>
                    <p class="ip-empty-description">Create your first role to start accepting applicant resumes and conducting video interviews.</p>
                    <a href="/create-job" class="ip-btn ip-btn-primary">Create Hiring Role</a>
                </div>
            <% } else { %>
                <div class="ip-roles-grid">
                    <% jobs.forEach(job => { %>
                        <div class="ip-role-card">
                            <div class="ip-role-header">
                                <div>
                                    <h2 class="ip-role-title"><%= job.title %></h2>
                                </div>
                                <span class="ip-badge ip-badge-<%= job.status %>"><%= job.status %></span>
                            </div>

                            <div class="ip-role-body">
                                <p class="ip-role-desc"><%= job.description %></p>
                            </div>

                            <div class="ip-role-footer">
                                <a href="/jobs/<%= job._id %>/applicants" class="ip-btn ip-btn-primary ip-btn-sm">
                                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                                    </svg>
                                    View Applicants
                                </a>
                                <a href="/dashboard" class="ip-btn ip-btn-secondary ip-btn-sm">Dashboard</a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>

        </div>
    </main>

</body>
</html>