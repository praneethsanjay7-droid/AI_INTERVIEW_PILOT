<!DOCTYPE html>
<html>
<head>
    <title>Candidate Interview</title>
    <style>
        .window-role {
            display: inline-block;
            margin: 16px 0 8px;
            padding: 8px 12px;
            border-left: 4px solid #087f8c;
            background: #e7f6f5;
            color: #07545b;
            font-weight: 700;
        }
    </style>
</head>

<body>

    <div class="window-role" role="status" aria-label="Current interview window: candidate">
        Candidate Window
    </div>

    <h1>Candidate Interview Room</h1>

    <h2>Interview Details</h2>

    <p>
        <strong>Job:</strong>
        <%= interview.application.job.title %>
    </p>

    <p>
        <strong>Candidate:</strong>
        <%= interview.application.candidate.name %>
    </p>

    <p>
        <strong>Interview Status:</strong>
        <%= interview.status %>
    </p>

    <hr>

    <h2>Camera & Microphone</h2>

    <video
        id="localVideo"
        autoplay
        muted
        playsinline
        width="400">
    </video>

    <br><br>

    <button id="enableMediaBtn">
        Enable Camera & Microphone
    </button>

    <p id="mediaStatus"></p>

    <hr>

<h2>Speech to Text</h2>

<button id="startSpeechBtn">
    Start Speaking
</button>

<button id="stopSpeechBtn" disabled>
    Stop Speaking
</button>

<p id="speechStatus"></p>

<p>
    <strong>Recognized Text:</strong>
</p>

<div id="speechText"></div>

<h3>Candidate</h3>

<video
    id="localVideo"
    autoplay
    muted
    playsinline
    width="400">
</video>

<h3>Interviewer</h3>

<video
    id="remoteVideo"
    autoplay
    playsinline
    width="400">
</video>


    <script src="/socket.io/socket.io.js"></script>
