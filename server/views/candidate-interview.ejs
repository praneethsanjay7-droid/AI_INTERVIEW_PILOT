<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Candidate Interview - InterviewPilot</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/candidate-interview.css">
</head>
<body class="ip-candidate-room-page">

    <!-- Candidate Room Header -->
    <header class="ip-candidate-room-navbar">
        <div style="display: flex; align-items: center; gap: 1.25rem;">
            <a href="/my-applications" class="ip-brand" style="color: #FFFFFF;">
                <div class="ip-brand-icon">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                </div>
                <span>Interview<span class="ip-brand-accent">Pilot</span></span>
            </a>

            <div class="ip-candidate-role-pill">Candidate Session</div>

            <div style="display: flex; flex-direction: column;">
                <span style="font-size: 1.125rem; font-weight: 700; color: #FFFFFF;">
                    <%= interview.application && interview.application.job ? interview.application.job.title : 'Interview' %>
                </span>
                <span style="font-size: 0.8125rem; color: #94A3B8;">
                    Candidate: <%= interview.application && interview.application.candidate ? interview.application.candidate.name : '' %>
                </span>
            </div>
        </div>

        <div style="display: flex; align-items: center; gap: 0.875rem;">
            <div class="ip-room-user-profile ip-room-user-candidate" title="Currently in room as Candidate: <%= (typeof user !== 'undefined' && user && user.name) ? user.name : (interview.application && interview.application.candidate ? interview.application.candidate.name : 'Candidate') %>">
                <div class="ip-room-user-avatar">
                    C
                </div>
                <div class="ip-room-user-info">
                    <span class="ip-room-user-name"><%= (typeof user !== 'undefined' && user && user.name) ? user.name : (interview.application && interview.application.candidate ? interview.application.candidate.name : 'Candidate') %></span>
                    <span class="ip-room-user-tag">Candidate Room</span>
                </div>
            </div>

            <span class="ip-badge ip-badge-<%= interview.status %>"><%= interview.status %></span>
            <a href="/my-applications" class="ip-btn ip-btn-secondary ip-btn-sm" style="background: #334155; color: #FFFFFF; border-color: #475569;">
                Back to Applications
            </a>
        </div>
    </header>

    <main class="ip-candidate-workspace">

        <!-- Video Feeds: Remote Interviewer & Local Candidate -->
        <div class="ip-candidate-video-grid">
            <!-- Interviewer Feed (Main Stage) -->
            <div class="ip-candidate-video-card">
                <div class="ip-candidate-video-header">
                    <span class="ip-video-tag" style="background: rgba(15, 23, 42, 0.85); color: #FFFFFF; padding: 0.25rem 0.625rem; border-radius: 9999px; font-size: 0.75rem;">
                        Interviewer (Live Feed)
                    </span>
                </div>
                <video id="remoteVideo" class="ip-candidate-video-element" autoplay playsinline></video>
            </div>

            <!-- Candidate Local Feed -->
            <div class="ip-candidate-video-card">
                <div class="ip-candidate-video-header">
                    <span class="ip-video-tag" style="background: rgba(15, 23, 42, 0.85); color: #FFFFFF; padding: 0.25rem 0.625rem; border-radius: 9999px; font-size: 0.75rem;">
                        You (Candidate)
                    </span>
                </div>
                <video id="localVideo" class="ip-candidate-video-element" autoplay muted playsinline></video>
            </div>
        </div>

        <!-- Camera / Mic Controls -->
        <div class="ip-media-controls-bar" style="background: #1E293B; border: 1px solid #334155; border-radius: var(--radius-lg); padding: 1rem 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
            <button id="enableMediaBtn" class="ip-btn ip-btn-primary">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                Enable Camera & Microphone
            </button>
            <span id="mediaStatus" style="font-size: 0.875rem; color: #94A3B8;"></span>
        </div>

        <!-- Speech & Audio Transcription Controls -->
        <div class="ip-candidate-controls-grid">

            <!-- Speech to Text Controls -->
            <div class="ip-candidate-tool-card">
                <div class="ip-tool-header">
                    <h3 class="ip-tool-title">Speech to Text</h3>
                    <span id="speechStatus" style="font-size: 0.8125rem; color: #94A3B8;"></span>
                </div>

                <div style="display: flex; gap: 0.75rem;">
                    <button id="startSpeechBtn" class="ip-btn ip-btn-secondary ip-btn-sm" style="background: #334155; color: #FFFFFF; border-color: #475569;">
                        Start Speaking
                    </button>
                    <button id="stopSpeechBtn" class="ip-btn ip-btn-secondary ip-btn-sm" style="background: #334155; color: #FFFFFF; border-color: #475569;" disabled>
                        Stop Speaking
                    </button>
                </div>

                <div>
                    <label class="ip-form-label" style="color: #CBD5E1; font-size: 0.8125rem;">Recognized Text</label>
                    <div id="speechText" class="ip-output-box"></div>
                </div>
            </div>

            <!-- Speech Audio Recording Test -->
            <div class="ip-candidate-tool-card">
                <div class="ip-tool-header">
                    <h3 class="ip-tool-title">Voice Recording & Live Transcription</h3>
                    <span id="recordingStatus" style="font-size: 0.8125rem; color: #94A3B8;"></span>
                </div>

                <div style="display: flex; gap: 0.75rem;">
                    <button id="startRecordingBtn" class="ip-btn ip-btn-secondary ip-btn-sm" style="background: #334155; color: #FFFFFF; border-color: #475569;">
                        Start Recording
                    </button>
                    <button id="stopRecordingBtn" class="ip-btn ip-btn-secondary ip-btn-sm" style="background: #334155; color: #FFFFFF; border-color: #475569;" disabled>
                        Stop Recording
                    </button>
                </div>

                <div>
                    <label class="ip-form-label" style="color: #CBD5E1; font-size: 0.8125rem;">Live Transcript Output</label>
                    <div id="transcriptResult" class="ip-output-box"></div>
                </div>
            </div>

        </div>

    </main>

    <!-- Preserved Socket.IO & WebRTC Logic -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        const interviewId = "<%= interview._id %>";

        socket.on("connect", () => {
            socket.emit("join-interview", {
                interviewId,
                role: "candidate"
            });
        });

        const enableMediaBtn = document.getElementById("enableMediaBtn");
        const localVideo = document.getElementById("localVideo");
        const remoteVideo = document.getElementById("remoteVideo");
        const mediaStatus = document.getElementById("mediaStatus");

        let candidateStream = null;
        let peerConnection = null;
        let pendingOffer = null;
        const pendingIceCandidates = [];

        const createPeerConnection = () => {
            if (peerConnection) {
                return;
            }

            peerConnection = new RTCPeerConnection();

            peerConnection.addEventListener("track", (event) => {
                if (event.streams[0] && remoteVideo) {
                    remoteVideo.srcObject = event.streams[0];
                }
            });

            peerConnection.addEventListener("icecandidate", (event) => {
                if (event.candidate) {
                    socket.emit("webrtc-ice-candidate", {
                        interviewId,
                        candidate: event.candidate
                    });
                }
            });
        };

        const answerPendingOffer = async () => {
            if (!candidateStream || !pendingOffer) {
                return;
            }

            createPeerConnection();

            try {
                await peerConnection.setRemoteDescription(pendingOffer);
                pendingOffer = null;

                candidateStream.getTracks().forEach((track) => {
                    peerConnection.addTrack(track, candidateStream);
                });

                while (pendingIceCandidates.length > 0) {
                    await peerConnection.addIceCandidate(
                        pendingIceCandidates.shift()
                    );
                }

                const answer = await peerConnection.createAnswer();
                await peerConnection.setLocalDescription(answer);

                socket.emit("webrtc-answer", {
                    interviewId,
                    answer: peerConnection.localDescription
                });
            } catch (error) {
                console.error("Failed to answer interviewer offer:", error);
                if (mediaStatus) mediaStatus.textContent = "Could not connect interview media.";
            }
        };

        if (enableMediaBtn) {
            enableMediaBtn.addEventListener("click", async () => {
                try {
                    candidateStream = await navigator.mediaDevices.getUserMedia({
                        video: true,
                        audio: true
                    });

                    if (localVideo) localVideo.srcObject = candidateStream;
                    createPeerConnection();
                    enableMediaBtn.disabled = true;
                    if (mediaStatus) mediaStatus.textContent = "Camera and microphone enabled.";
                    socket.emit("candidate-media-enabled", interviewId);

                    await answerPendingOffer();
                } catch (error) {
                    console.error("Candidate camera or microphone error:", error);
                    if (mediaStatus) mediaStatus.textContent = "Could not access camera or microphone.";
                }
            });
        }

        socket.on("webrtc-offer", async (data) => {
            pendingOffer = data.offer;
            await answerPendingOffer();
        });

        socket.on("webrtc-ice-candidate", async (data) => {
            if (!peerConnection || !peerConnection.remoteDescription) {
                pendingIceCandidates.push(data.candidate);
                return;
            }

            try {
                await peerConnection.addIceCandidate(data.candidate);
            } catch (error) {
                console.error("Failed to add interviewer ICE candidate:", error);
            }
        });

        const startRecordingBtn = document.getElementById("startRecordingBtn");
        const stopRecordingBtn = document.getElementById("stopRecordingBtn");
        const recordingStatus = document.getElementById("recordingStatus");
        const transcriptResult = document.getElementById("transcriptResult");

        let mediaRecorder;
        let recordingStream = null;
        let audioChunks = [];

        if (startRecordingBtn) {
            startRecordingBtn.addEventListener("click", async () => {
                try {
                    recordingStream = await navigator.mediaDevices.getUserMedia({
                        audio: true
                    });

                    const options = MediaRecorder.isTypeSupported("audio/webm;codecs=opus")
                        ? { mimeType: "audio/webm;codecs=opus" }
                        : {};

                    mediaRecorder = new MediaRecorder(recordingStream, options);
                    audioChunks = [];

                    mediaRecorder.addEventListener("dataavailable", (event) => {
                        if (event.data.size > 0) {
                            audioChunks.push(event.data);
                        }
                    });

                    mediaRecorder.addEventListener("stop", async () => {
                        try {
                            if (recordingStatus) recordingStatus.textContent = "Sending audio for transcription...";

                            const audioBlob = new Blob(audioChunks, {
                                type: mediaRecorder.mimeType
                            });

                            if (audioBlob.size === 0) {
                                throw new Error("Recording did not contain any audio data");
                            }

                            const formData = new FormData();
                            formData.append("audio", audioBlob, "recording.webm");

                            const response = await fetch("/transcribe-audio", {
                                method: "POST",
                                body: formData
                            });
                            const result = await response.json();

                            if (!response.ok) {
                                throw new Error(result.error || "Transcription failed");
                            }

                            if (transcriptResult) transcriptResult.textContent = result.transcript;

                            socket.emit("transcript", {
                                interviewId: interviewId,
                                text: result.transcript,
                                speaker: "candidate"
                            });

                            if (recordingStatus) recordingStatus.textContent = "Transcription completed.";
                        } catch (error) {
                            console.error("Transcription error:", error);
                            if (recordingStatus) recordingStatus.textContent = "Transcription failed.";
                        } finally {
                            if (recordingStream) {
                                recordingStream.getTracks().forEach((track) => track.stop());
                                recordingStream = null;
                            }

                            if (startRecordingBtn) startRecordingBtn.disabled = false;
                            if (stopRecordingBtn) stopRecordingBtn.disabled = true;
                        }
                    });

                    mediaRecorder.start();
                    if (recordingStatus) recordingStatus.textContent = "Recording...";
                    startRecordingBtn.disabled = true;
                    if (stopRecordingBtn) stopRecordingBtn.disabled = false;
                } catch (error) {
                    console.error("Microphone error:", error);
                    if (recordingStatus) recordingStatus.textContent = "Could not access microphone.";

                    if (recordingStream) {
                        recordingStream.getTracks().forEach((track) => track.stop());
                        recordingStream = null;
                    }
                }
            });
        }

        if (stopRecordingBtn) {
            stopRecordingBtn.addEventListener("click", () => {
                if (mediaRecorder && mediaRecorder.state !== "inactive") {
                    mediaRecorder.stop();
                    if (recordingStatus) recordingStatus.textContent = "Processing audio...";
                    stopRecordingBtn.disabled = true;
                }
            });
        }

        // --- Start Speaking (Web Speech API) Logic ---
        const startSpeechBtn = document.getElementById("startSpeechBtn");
        const stopSpeechBtn = document.getElementById("stopSpeechBtn");
        const speechStatus = document.getElementById("speechStatus");
        const speechText = document.getElementById("speechText");
        
        let recognition = null;
        if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            recognition = new SpeechRecognition();
            recognition.continuous = true;
            recognition.interimResults = true;
            
            recognition.onresult = (event) => {
                let finalTranscript = '';
                let interimTranscript = '';
                for (let i = event.resultIndex; i < event.results.length; ++i) {
                    if (event.results[i].isFinal) {
                        finalTranscript += event.results[i][0].transcript;
                        // Emit final transcript to socket
                        socket.emit("transcript", {
                            interviewId: interviewId,
                            text: event.results[i][0].transcript.trim(),
                            speaker: "candidate"
                        });
                    } else {
                        interimTranscript += event.results[i][0].transcript;
                    }
                }
                if (speechText) {
                    speechText.innerHTML = finalTranscript + '<i style="color:#94A3B8;">' + interimTranscript + '</i>';
                }
            };
            
            recognition.onerror = (event) => {
                console.error("Speech recognition error", event.error);
                if (speechStatus) speechStatus.textContent = "Error: " + event.error;
            };
            
            recognition.onend = () => {
                if (startSpeechBtn) startSpeechBtn.disabled = false;
                if (stopSpeechBtn) stopSpeechBtn.disabled = true;
                if (speechStatus) speechStatus.textContent = "Stopped listening.";
            };
        } else {
            if (speechStatus) speechStatus.textContent = "Speech Recognition not supported in this browser.";
            if (startSpeechBtn) startSpeechBtn.disabled = true;
        }

        if (startSpeechBtn && recognition) {
            startSpeechBtn.addEventListener("click", () => {
                recognition.start();
                startSpeechBtn.disabled = true;
                if (stopSpeechBtn) stopSpeechBtn.disabled = false;
                if (speechStatus) speechStatus.textContent = "Listening...";
                if (speechText) speechText.textContent = "";
            });
        }

        if (stopSpeechBtn && recognition) {
            stopSpeechBtn.addEventListener("click", () => {
                recognition.stop();
                startSpeechBtn.disabled = false;
                stopSpeechBtn.disabled = true;
                if (speechStatus) speechStatus.textContent = "Stopped listening.";
            });
        }
    </script>

</body>
</html>
