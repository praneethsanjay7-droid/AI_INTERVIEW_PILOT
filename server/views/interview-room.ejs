<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interview Room</title>
    <style>
        .window-role {
            display: inline-block;
            margin: 16px 0 8px;
            padding: 8px 12px;
            border-left: 4px solid #a34f00;
            background: #fff2df;
            color: #713800;
            font-weight: 700;
        }
    </style>
</head>

<body>

    <div class="window-role" role="status" aria-label="Current interview window: interviewer">
        Interviewer Window
    </div>

    <h1>Interview Room</h1>

    <hr>

    <h2>Candidate</h2>

    <p>
        <strong>Name:</strong>
        <%= interview.application.candidate.name %>
    </p>

    <p>
        <strong>Email:</strong>
        <%= interview.application.candidate.email %>
    </p>

    <hr>

    <h2>Job</h2>

    <p>
        <strong>Position:</strong>
        <%= interview.application.job.title %>
    </p>

    <p>
        <strong>Description:</strong>
        <%= interview.application.job.description %>
    </p>

    <hr>

    <h2>Interview Details</h2>

    <p>
        <strong>Scheduled At:</strong>
        <%= interview.scheduledAt %>
    </p>

    <p>
        <strong>Status:</strong>
        <%= interview.status %>
    </p>

    <hr>

    <h2>Interview Schedule</h2>
<h2>Interview Status</h2>

<% if (interview.status === "scheduled") { %>

    <h3 id="countdownTitle">Interview starts in</h3>

    <p id="countdown">
        <span id="hours">00</span> :
        <span id="minutes">00</span> :
        <span id="seconds">00</span>
    </p>

    <p id="statusMessage">
        Please wait until the scheduled interview time.
    </p>

    <hr>

    <h2>Candidate Consent</h2>

    <p>
        Before starting the interview, the candidate must give
        consent for the interview to be recorded and transcribed.
    </p>

    <label>
        <input type="checkbox" id="consentCheckbox">
        I confirm that the candidate has given consent
        for the interview to be recorded and transcribed.
    </label>

    <br><br>

    <form
        action="/interview-room/<%= interview._id %>/start"
        method="POST"
    >
        <button
            id="startInterviewBtn"
            type="submit"
            disabled
        >
            Start Interview
        </button>
    </form>

    <p id="waitingMessage">
        Please wait until the scheduled interview time.
    </p>

<% } else if (interview.status === "ongoing") { %>

    <h3>Interview is currently ongoing</h3>

    <p>
        The interview has started successfully.
    </p>
<form
    action="/interview-room/<%= interview._id %>/end"
    method="POST"
>
    <button type="submit">
        End Interview
    </button>
</form>

<% } else if (interview.status === "completed") { %>

    <h3>Interview completed</h3>

    <a href="/interview-room/<%= interview._id %>/evaluation">
        Evaluate Interview
    </a>

    <br><br>

    <a href="/interview-room/<%= interview._id %>/summary">
        View AI Summary
    </a>

    <br><br>

    <form
        action="/interview-room/<%= interview._id %>/generate-summary"
        method="POST"
    >
        <button type="submit">
            Generate AI Summary
        </button>
    </form>
<br><br>

<a href="/interview-room/<%= interview._id %>/report">
    View Final Interview Report
</a>

<% } else if (interview.status === "cancelled") { %>

    <h3>Interview cancelled</h3>

<% } %>
<hr>

<h2>Live Transcript</h2>

<div id="transcript">

    <% transcripts.forEach(item => { %>

        <p>
            <strong><%= item.speaker %>:</strong>
            <%= item.text %>
        </p>

    <% }) %>

</div>
<br>

<hr>

<h2>AI Follow-up Questions</h2>

<div id="follow-up-questions">
    <p>No follow-up questions yet.</p>
</div>
<hr>

<h2>Interviewer Notes</h2>

<form method="POST" action="/interview-room/<%= interview._id %>/note">

    <textarea
        name="text"
        rows="5"
        cols="60"
        placeholder="Write your notes about the candidate..."
        required
    ></textarea>

    <br><br>

    <button type="submit">Save Note</button>

</form>

<h3>Previous Notes</h3>

<div id="notes">

    <% if (notes && notes.length > 0) { %>

        <% notes.forEach(note => { %>

            <p>
                <%= note.text %>
            </p>

        <% }) %>

    <% } else { %>

        <p>No notes yet.</p>

    <% } %>

</div>

<input
    type="text"
    id="transcriptInput"
    placeholder="Enter transcript text"
>

<button id="sendTranscriptBtn">
    Send Transcript
</button>

<hr>

<h2>Interview Media</h2>

<video
    id="localVideo"
    autoplay
    muted
    playsinline
    width="400"
></video>

<br><br>

<button id="enableMediaBtn">
    Enable Camera & Microphone
</button>

<p id="mediaStatus"></p>

<h3>Interviewer</h3>

<video
    id="localVideo"
    autoplay
    muted
    playsinline
    width="400">
</video>

<h3>Candidate</h3>

<video
    id="remoteVideo"
    autoplay
    playsinline
    width="400">
</video>



<% if (interview.status === "scheduled") { %>
    <script>

        /*
         * Get the scheduled interview time
         * from the Interview document.
         */
        const scheduledTime = new Date(
            "<%= interview.scheduledAt.toISOString() %>"
        ).getTime();


        /*
         * Get HTML elements.
         */
        const countdownTitle =
            document.getElementById("countdownTitle");

        const hoursElement =
            document.getElementById("hours");

        const minutesElement =
            document.getElementById("minutes");

        const secondsElement =
            document.getElementById("seconds");

        const statusMessage =
            document.getElementById("statusMessage");

        const consentCheckbox =
            document.getElementById("consentCheckbox");

        const startInterviewBtn =
            document.getElementById("startInterviewBtn");

        const waitingMessage =
            document.getElementById("waitingMessage");


        /*
         * Indicates whether the scheduled
         * interview time has arrived.
         */
        let interviewTimeReached = false;


        /*
         * Enable/disable Start Interview button.
         */
        function updateStartButton() {

    if (!startInterviewBtn || !consentCheckbox) {
        return;
    }

            startInterviewBtn.disabled = !(
                interviewTimeReached && consentCheckbox.checked
            );

            if (!interviewTimeReached) {
                waitingMessage.textContent =
                    "Please wait until the scheduled interview time.";
            } else if (!consentCheckbox.checked) {
                waitingMessage.textContent =
                    "Please confirm candidate consent to continue.";
            } else {
                waitingMessage.textContent =
                    "The interview is ready to start.";
            }
        }


        /*
         * Update countdown.
         */
        function updateCountdown() {

            const currentTime = Date.now();

            const difference =
                scheduledTime - currentTime;


            /*
             * Interview time has arrived.
             */
            if (difference <= 0) {

                interviewTimeReached = true;

                countdownTitle.textContent =
                    "Interview is ready to start";

                hoursElement.textContent = "00";
                minutesElement.textContent = "00";
                secondsElement.textContent = "00";

                statusMessage.textContent =
                    "The scheduled interview time has arrived.";

                updateStartButton();

                return;
            }


            /*
             * Convert remaining milliseconds
             * into hours, minutes and seconds.
             */
            const totalSeconds =
                Math.floor(difference / 1000);

            const hours =
                Math.floor(totalSeconds / 3600);

            const minutes =
                Math.floor(
                    (totalSeconds % 3600) / 60
                );

            const seconds =
                totalSeconds % 60;


            /*
             * Display countdown.
             */
            hoursElement.textContent =
                String(hours).padStart(2, "0");

            minutesElement.textContent =
                String(minutes).padStart(2, "0");

            secondsElement.textContent =
                String(seconds).padStart(2, "0");

            updateStartButton();
        }


        /*
         * When consent changes,
         * check whether Start Interview
         * can be enabled.
         */
        consentCheckbox.addEventListener(
            "change",
            updateStartButton
        );


        /*
         * Run once immediately.
         */
        updateCountdown();


        /*
         * Update countdown every second.
         */
        if (!interviewTimeReached) {
            const countdownTimer = setInterval(
                () => {
                    updateCountdown();

                    if (interviewTimeReached) {
                        clearInterval(countdownTimer);
                    }
                },
                1000
            );
        }

    </script>
<% } %>

    <script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();

    const interviewId = "<%= interview._id %>";

    socket.on("connect", () => {
        console.log("Connected to Socket.IO:", socket.id);

        socket.emit("join-interview", {
            interviewId,
            role: "interviewer"
        });
    });

    socket.on("interview-participant-connected", (participant) => {
        if (participant.role === "candidate") {
            console.log(
                "Candidate connected to Socket.IO:",
                participant.socketId
            );
        }
    });

    socket.on("candidate-media-enabled", () => {
        console.log("Candidate camera and microphone enabled");
    });

    socket.on("disconnect", () => {
        console.log("Disconnected from Socket.IO");
    });


    // -------------------------
    // TRANSCRIPT
    // -------------------------

    const transcriptInput =
        document.getElementById("transcriptInput");

    const sendTranscriptBtn =
        document.getElementById("sendTranscriptBtn");

    const transcript =
        document.getElementById("transcript");

    sendTranscriptBtn.addEventListener("click", () => {

        const text = transcriptInput.value.trim();

        if (!text) {
            return;
        }

        socket.emit("transcript", {
            interviewId: interviewId,
            text: text
        });

        transcriptInput.value = "";
    });
socket.on("transcript", (data) => {

    console.log("INTERVIEWER RECEIVED TRANSCRIPT:", data);

    const paragraph = document.createElement("p");

    paragraph.textContent =
        `${data.speaker}: ${data.text}`;

    transcript.appendChild(paragraph);

});

socket.on("follow-up-questions", (data) => {

    console.log(
        "INTERVIEWER RECEIVED FOLLOW-UP QUESTIONS:",
        data.questions
    );

    const container = document.getElementById("follow-up-questions");

    container.innerHTML = "";

    const questions = data.questions.split("\n");

    questions.forEach(question => {

        const paragraph = document.createElement("p");

        paragraph.textContent = question;

        container.appendChild(paragraph);
    });

});


    // -------------------------
    // CAMERA / MICROPHONE
    // -------------------------

    const localVideo =
        document.getElementById("localVideo");

    const enableMediaBtn =
        document.getElementById("enableMediaBtn");

    const mediaStatus =
        document.getElementById("mediaStatus");

    let localStream = null;

    let peerConnection = null;
    const remoteVideo=document.getElementById("remoteVideo");
    console.log("Remote video element:", remoteVideo);


    peerConnection=new RTCPeerConnection();

peerConnection.addEventListener("track", (event) => {

    console.log("Remote track received");
    console.log("Track kind:", event.track.kind);
    console.log("Track enabled:", event.track.enabled);
    console.log("Track readyState:", event.track.readyState);

    if (event.streams && event.streams[0]) {

        remoteVideo.srcObject = event.streams[0];

        console.log(
            "Remote stream assigned:",
            remoteVideo.srcObject
        );

        console.log(
            "Remote video tracks:",
            event.streams[0].getVideoTracks()
        );

        console.log(
            "Remote audio tracks:",
            event.streams[0].getAudioTracks()
        );
    }
});
    // -------------------------
    // INTERVIEWER STARTS WEBRTC
    // -------------------------

    enableMediaBtn.addEventListener("click", async () => {

        try {

            localStream =
                await navigator.mediaDevices.getUserMedia({
                    video: true,
                    audio: true
                });

            localVideo.srcObject = localStream;


            // Create PeerConnection
            peerConnection = new RTCPeerConnection();


            // -------------------------
            // ICE CANDIDATE LISTENER
    peerConnection.addEventListener("track", (event) => {

    console.log("Remote track received");

    console.log("Track kind:", event.track.kind);
    console.log("Track enabled:", event.track.enabled);
    console.log("Track readyState:", event.track.readyState);

    if (event.streams && event.streams[0]) {

        remoteVideo.srcObject = event.streams[0];

        console.log(
            "Remote stream assigned:",
            remoteVideo.srcObject
        );

        console.log(
            "Remote video tracks:",
            event.streams[0].getVideoTracks()
        );

        console.log(
            "Remote audio tracks:",
            event.streams[0].getAudioTracks()
        );
    }
});

            peerConnection.addEventListener(
                "icecandidate",
                (event) => {

                    if (event.candidate) {

                        socket.emit("webrtc-ice-candidate", {
                            interviewId: interviewId,
                            candidate: event.candidate
                        });

                        console.log(
                            "Interviewer ICE candidate sent"
                        );
                    }

                }
            );


            // Add camera and microphone tracks
            localStream.getTracks().forEach((track) => {

                peerConnection.addTrack(
                    track,
                    localStream
                );

            });


            // Create offer
            const offer =
                await peerConnection.createOffer();


            await peerConnection.setLocalDescription(
                offer
            );


            // Send offer to candidate
            socket.emit("webrtc-offer", {

                interviewId: interviewId,

                offer:
                    peerConnection.localDescription

            });


            console.log("WebRTC offer sent");


            mediaStatus.textContent =
                "Camera and microphone enabled.";

            enableMediaBtn.disabled = true;


        } catch (error) {

            console.error(error);

            mediaStatus.textContent =
                "Camera or microphone permission was denied.";

        }

    });


    // -------------------------
    // RECEIVE WEBRTC ANSWER
    // -------------------------

    socket.on("webrtc-answer", async (data) => {

        try {

            await peerConnection.setRemoteDescription(
                data.answer
            );

            console.log(
                "WebRTC answer received"
            );

        } catch (error) {

            console.error(
                "Failed to apply WebRTC answer:",
                error
            );

        }

    });


    // -------------------------
    // RECEIVE ICE CANDIDATE
    // -------------------------

    socket.on(
        "webrtc-ice-candidate",
        async (data) => {

            try {

                await peerConnection.addIceCandidate(
                    data.candidate
                );

                console.log(
                    "Interviewer ICE candidate received"
                );

            } catch (error) {

                console.error(
                    "Failed to add interviewer ICE candidate:",
                    error
                );

            }

        }
    );


</script>

</body>

</html>
```
