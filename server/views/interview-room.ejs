<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interview Room</title>
</head>

<body>

    <h1>Interview Room</h1>

    <hr>

    <h2>Candidate</h2>

    <p>
        <strong>Name:</strong>
        <%= interview.application.candidate.name %>
    </p>

    <p>
        <strong>Email:</strong>
        <%= interview.application.candidate.email %>
    </p>

    <hr>

    <h2>Job</h2>

    <p>
        <strong>Position:</strong>
        <%= interview.application.job.title %>
    </p>

    <p>
        <strong>Description:</strong>
        <%= interview.application.job.description %>
    </p>

    <hr>

    <h2>Interview Details</h2>

    <p>
        <strong>Scheduled At:</strong>
        <%= interview.scheduledAt %>
    </p>

    <p>
        <strong>Status:</strong>
        <%= interview.status %>
    </p>

    <hr>

    <h2>Interview Schedule</h2>
<h2>Interview Status</h2>

<% if (interview.status === "scheduled") { %>

    <h3 id="countdownTitle">Interview starts in</h3>

    <p id="countdown">
        <span id="hours">00</span> :
        <span id="minutes">00</span> :
        <span id="seconds">00</span>
    </p>

    <p id="statusMessage">
        Please wait until the scheduled interview time.
    </p>

    <hr>

    <h2>Candidate Consent</h2>

    <p>
        Before starting the interview, the candidate must give
        consent for the interview to be recorded and transcribed.
    </p>

    <label>
        <input type="checkbox" id="consentCheckbox">
        I confirm that the candidate has given consent
        for the interview to be recorded and transcribed.
    </label>

    <br><br>

    <form
        action="/interview-room/<%= interview._id %>/start"
        method="POST"
    >
        <button
            id="startInterviewBtn"
            type="submit"
            disabled
        >
            Start Interview
        </button>
    </form>

    <p id="waitingMessage">
        Please wait until the scheduled interview time.
    </p>

<% } else if (interview.status === "ongoing") { %>

    <h3>Interview is currently ongoing</h3>

    <p>
        The interview has started successfully.
    </p>

<% } else if (interview.status === "completed") { %>

    <h3>Interview completed</h3>

<% } else if (interview.status === "cancelled") { %>

    <h3>Interview cancelled</h3>

<% } %>
<hr>

<h2>Live Transcript</h2>

<div id="transcript"></div>

<br>

<input
    type="text"
    id="transcriptInput"
    placeholder="Enter transcript text"
>

<button id="sendTranscriptBtn">
    Send Transcript
</button>

<% if (interview.status === "scheduled") { %>
    <script>

        /*
         * Get the scheduled interview time
         * from the Interview document.
         */
        const scheduledTime = new Date(
            "<%= interview.scheduledAt.toISOString() %>"
        ).getTime();


        /*
         * Get HTML elements.
         */
        const countdownTitle =
            document.getElementById("countdownTitle");

        const hoursElement =
            document.getElementById("hours");

        const minutesElement =
            document.getElementById("minutes");

        const secondsElement =
            document.getElementById("seconds");

        const statusMessage =
            document.getElementById("statusMessage");

        const consentCheckbox =
            document.getElementById("consentCheckbox");

        const startInterviewBtn =
            document.getElementById("startInterviewBtn");

        const waitingMessage =
            document.getElementById("waitingMessage");


        /*
         * Indicates whether the scheduled
         * interview time has arrived.
         */
        let interviewTimeReached = false;


        /*
         * Enable/disable Start Interview button.
         */
        function updateStartButton() {

    if (!startInterviewBtn || !consentCheckbox) {
        return;
    }

            startInterviewBtn.disabled = !(
                interviewTimeReached && consentCheckbox.checked
            );

            if (!interviewTimeReached) {
                waitingMessage.textContent =
                    "Please wait until the scheduled interview time.";
            } else if (!consentCheckbox.checked) {
                waitingMessage.textContent =
                    "Please confirm candidate consent to continue.";
            } else {
                waitingMessage.textContent =
                    "The interview is ready to start.";
            }
        }


        /*
         * Update countdown.
         */
        function updateCountdown() {

            const currentTime = Date.now();

            const difference =
                scheduledTime - currentTime;


            /*
             * Interview time has arrived.
             */
            if (difference <= 0) {

                interviewTimeReached = true;

                countdownTitle.textContent =
                    "Interview is ready to start";

                hoursElement.textContent = "00";
                minutesElement.textContent = "00";
                secondsElement.textContent = "00";

                statusMessage.textContent =
                    "The scheduled interview time has arrived.";

                updateStartButton();

                return;
            }


            /*
             * Convert remaining milliseconds
             * into hours, minutes and seconds.
             */
            const totalSeconds =
                Math.floor(difference / 1000);

            const hours =
                Math.floor(totalSeconds / 3600);

            const minutes =
                Math.floor(
                    (totalSeconds % 3600) / 60
                );

            const seconds =
                totalSeconds % 60;


            /*
             * Display countdown.
             */
            hoursElement.textContent =
                String(hours).padStart(2, "0");

            minutesElement.textContent =
                String(minutes).padStart(2, "0");

            secondsElement.textContent =
                String(seconds).padStart(2, "0");

            updateStartButton();
        }


        /*
         * When consent changes,
         * check whether Start Interview
         * can be enabled.
         */
        consentCheckbox.addEventListener(
            "change",
            updateStartButton
        );


        /*
         * Run once immediately.
         */
        updateCountdown();


        /*
         * Update countdown every second.
         */
        if (!interviewTimeReached) {
            const countdownTimer = setInterval(
                () => {
                    updateCountdown();

                    if (interviewTimeReached) {
                        clearInterval(countdownTimer);
                    }
                },
                1000
            );
        }

    </script>
<% } %>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();

const interviewId = "<%= interview._id %>";

socket.on("connect", () => {
    console.log("Connected to Socket.IO:", socket.id);

    socket.emit("join-interview", interviewId);
});

socket.on("disconnect", () => {
    console.log("Disconnected from Socket.IO");
});

const transcriptInput =
    document.getElementById("transcriptInput");

const sendTranscriptBtn =
    document.getElementById("sendTranscriptBtn");

const transcript =
    document.getElementById("transcript");

sendTranscriptBtn.addEventListener("click", () => {

    const text = transcriptInput.value.trim();

    if (!text) {
        return;
    }

    socket.emit("transcript", {
        interviewId: interviewId,
        text: text
    });

    transcriptInput.value = "";
});

socket.on("transcript", (data) => {

    const paragraph = document.createElement("p");

    paragraph.textContent = data.text;

    transcript.appendChild(paragraph);

});

    </script>

</body>

</html>
```
