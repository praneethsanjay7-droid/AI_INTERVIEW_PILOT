<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Hiring Role - InterviewPilot</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/create-job.css">
</head>
<body>

    <!-- Global Navigation -->
    <header class="ip-navbar">
        <div class="ip-container ip-navbar-inner">
            <a href="/dashboard" class="ip-brand">
                <div class="ip-brand-icon">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                </div>
                <span>Interview<span class="ip-brand-accent">Pilot</span></span>
            </a>

            <nav style="display: flex; align-items: center; gap: 0.75rem;">
                <ul class="ip-nav-links">
                    <li><a href="/dashboard" class="ip-nav-link">Dashboard</a></li>
                    <li><a href="/jobs" class="ip-nav-link">Hiring Roles</a></li>
                    <li><a href="/create-job" class="ip-nav-link active">+ Create Role</a></li>
                </ul>

                <% 
                    const currentUser = typeof user !== 'undefined' && user ? user : null;
                    const isCandidate = currentUser && currentUser.role === 'candidate';
                    const roleLetter = isCandidate ? 'C' : 'I';
                    const avatarClass = isCandidate ? 'ip-avatar-candidate' : 'ip-avatar-interviewer';
                    const roleTitle = isCandidate ? (currentUser.name || 'Candidate') : (currentUser && currentUser.name ? currentUser.name : 'Interviewer');
                    const roleSub = isCandidate ? 'Candidate' : 'Interviewer';
                %>
                <div class="ip-user-profile-widget" title="Logged in as <%= roleSub %>">
                    <div class="ip-user-avatar <%= avatarClass %>">
                        <%= roleLetter %>
                    </div>
                    <div class="ip-user-meta-text">
                        <span class="ip-user-name"><%= roleTitle %></span>
                        <span class="ip-user-role-label"><%= roleSub %></span>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="ip-page-wrapper">
        <div class="ip-container">

            <div class="ip-form-card">
                <div class="ip-page-header">
                    <h1>Create New Hiring Role</h1>
                    <p class="ip-page-subtitle">Publish a job opening to collect candidate applications and conduct structured interviews.</p>
                </div>

                <form action="/create-job" method="POST">
                    <div class="ip-form-group">
                        <label class="ip-form-label" for="title">Job Title</label>
                        <input
                            id="title"
                            class="ip-input"
                            type="text"
                            name="title"
                            placeholder="e.g. Senior Frontend Engineer"
                            required
                        >
                        <span class="ip-form-hint">Use a descriptive role title that candidates recognize.</span>
                    </div>

                    <div class="ip-form-group">
                        <label class="ip-form-label" for="description">Job Description & Requirements</label>
                        <textarea
                            id="description"
                            class="ip-textarea"
                            name="description"
                            rows="6"
                            placeholder="Detail key responsibilities, qualifications, tech stack, and evaluation criteria..."
                            required
                        ></textarea>
                    </div>

                    <div class="ip-form-actions-row">
                        <a href="/dashboard" class="ip-btn ip-btn-secondary">Cancel</a>
                        <button class="ip-btn ip-btn-primary" type="submit">
                            Create Hiring Role
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </main>

</body>
</html>