<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apply for <%= job.title %> - InterviewPilot</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/apply-for.css">
</head>
<body>

    <!-- Global Navigation -->
    <header class="ip-navbar">
        <div class="ip-container ip-navbar-inner">
            <a href="/dashboard" class="ip-brand">
                <div class="ip-brand-icon">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                </div>
                <span>Interview<span class="ip-brand-accent">Pilot</span></span>
            </a>

            <nav>
                <ul class="ip-nav-links">
                    <li><a href="/dashboard" class="ip-nav-link">Dashboard</a></li>
                    <li><a href="/available-jobs" class="ip-nav-link active">Available Jobs</a></li>
                    <li><a href="/my-applications" class="ip-nav-link">My Applications</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main class="ip-page-wrapper">
        <div class="ip-container ip-apply-container">

            <div class="ip-apply-card">
                <div class="ip-page-header">
                    <span class="ip-badge ip-badge-open" style="margin-bottom: 0.5rem;">Job Application</span>
                    <h1>Apply for <%= job.title %></h1>
                    <p class="ip-page-subtitle">Submit your PDF resume for consideration and interview scheduling.</p>
                </div>

                <!-- Job Brief -->
                <div class="ip-job-summary-box">
                    <h3>Position Overview</h3>
                    <p><%= job.description %></p>
                </div>

                <form
                    action="/apply/<%= job._id %>"
                    method="POST"
                    enctype="multipart/form-data"
                >
                    <div class="ip-form-group">
                        <label class="ip-form-label" for="resume">Upload Resume (PDF only)</label>
                        
                        <div class="ip-file-upload-box">
                            <svg class="ip-file-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                            </svg>
                            <p style="font-weight: 600; color: var(--color-text-primary); margin-bottom: 0.25rem;">
                                Select your resume file
                            </p>
                            <p class="ip-form-hint" style="margin-bottom: 0.75rem;">Supported format: PDF (.pdf)</p>
                            <input
                                id="resume"
                                class="ip-file-input"
                                type="file"
                                name="resume"
                                accept=".pdf"
                                required
                            >
                        </div>
                    </div>

                    <div class="ip-apply-actions">
                        <a href="/available-jobs" class="ip-btn ip-btn-secondary">Back to Jobs</a>
                        <button class="ip-btn ip-btn-primary" type="submit">
                            Submit Application
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </main>

</body>
</html>