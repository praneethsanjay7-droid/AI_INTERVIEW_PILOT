<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - InterviewPilot</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>

    <!-- Global Top Navigation -->
    <header class="ip-navbar">
        <div class="ip-container ip-navbar-inner">
            <a href="/dashboard" class="ip-brand">
                <div class="ip-brand-icon">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                </div>
                <span>Interview<span class="ip-brand-accent">Pilot</span></span>
            </a>

            <nav>
                <ul class="ip-nav-links">
                    <li><a href="/dashboard" class="ip-nav-link active">Dashboard</a></li>
                    <li><a href="/jobs" class="ip-nav-link">Hiring Roles</a></li>
                    <li><a href="/available-jobs" class="ip-nav-link">Available Jobs</a></li>
                    <li><a href="/my-applications" class="ip-nav-link">My Applications</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main class="ip-page-wrapper">
        <div class="ip-container">

            <!-- Welcome & Quick Action Banner -->
            <div class="ip-dashboard-banner">
                <div class="ip-banner-content">
                    <h2>Interview Command Center</h2>
                    <p>Manage open hiring roles, review candidate applications, and launch AI-assisted video interviews.</p>
                </div>
                <div class="ip-banner-actions">
                    <a href="/create-job" class="ip-btn ip-btn-primary">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Create Hiring Role
                    </a>
                    <a href="/available-jobs" class="ip-btn ip-btn-secondary">
                        Browse Jobs Board
                    </a>
                </div>
            </div>

            <!-- Interactive End-to-End Journey Navigator -->
            <section class="ip-journey-section">
                <div class="ip-journey-header">
                    <div class="ip-journey-header-info">
                        <h3>
                            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--color-primary-600);">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                            </svg>
                            End-to-End Workflow Guide
                        </h3>
                        <p>Navigate the complete lifecycle for recruiters/interviewers or job candidates</p>
                    </div>

                    <!-- Role Switcher Tabs -->
                    <div class="ip-role-nav-switch" role="tablist">
                        <button id="tabInterviewer" class="ip-role-tab-btn active" type="button" role="tab" onclick="switchJourney('interviewer')">
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                            Interviewer Journey
                        </button>
                        <button id="tabCandidate" class="ip-role-tab-btn" type="button" role="tab" onclick="switchJourney('candidate')">
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            Candidate Journey
                        </button>
                    </div>
                </div>

                <!-- Interviewer End-to-End Journey Track -->
                <div id="journeyInterviewer" class="ip-journey-track">
                    <div class="ip-journey-step-card">
                        <div class="ip-step-top">
                            <span class="ip-step-number-badge">1</span>
                            <span class="ip-badge ip-badge-open">Start</span>
                        </div>
                        <div class="ip-step-content">
                            <h4 class="ip-step-title">Create Hiring Role</h4>
                            <p class="ip-step-desc">Publish job openings with requirements to receive candidate applications.</p>
                        </div>
                        <div class="ip-step-action">
                            <a href="/create-job" class="ip-btn ip-btn-primary ip-btn-sm ip-btn-block">
                                Create Role &rarr;
                            </a>
                        </div>
                    </div>

                    <div class="ip-journey-step-card">
                        <div class="ip-step-top">
                            <span class="ip-step-number-badge">2</span>
                            <span class="ip-badge ip-badge-applied">Pipelines</span>
                        </div>
                        <div class="ip-step-content">
                            <h4 class="ip-step-title">Review Hiring Roles</h4>
                            <p class="ip-step-desc">Manage all active positions, see candidate applicant counts, and track statuses.</p>
                        </div>
                        <div class="ip-step-action">
                            <a href="/jobs" class="ip-btn ip-btn-secondary ip-btn-sm ip-btn-block">
                                View Roles &rarr;
                            </a>
                        </div>
                    </div>

                    <div class="ip-journey-step-card">
                        <div class="ip-step-top">
                            <span class="ip-step-number-badge">3</span>
                            <span class="ip-badge ip-badge-shortlisted">Review</span>
                        </div>
                        <div class="ip-step-content">
                            <h4 class="ip-step-title">Screen Applicants</h4>
                            <p class="ip-step-desc">Inspect candidate PDF resumes and select qualified candidates for interview.</p>
                        </div>
                        <div class="ip-step-action">
                            <a href="/jobs" class="ip-btn ip-btn-secondary ip-btn-sm ip-btn-block">
                                Open Applicants &rarr;
                            </a>
                        </div>
                    </div>

                    <div class="ip-journey-step-card">
                        <div class="ip-step-top">
                            <span class="ip-step-number-badge">4</span>
                            <span class="ip-badge ip-badge-scheduled">Schedule</span>
                        </div>
                        <div class="ip-step-content">
                            <h4 class="ip-step-title">Schedule Interview</h4>
                            <p class="ip-step-desc">Set date & time for live video interview sessions with automated room setup.</p>
                        </div>
                        <div class="ip-step-action">
                            <a href="/jobs" class="ip-btn ip-btn-secondary ip-btn-sm ip-btn-block">
                                Schedule Flow &rarr;
                            </a>
                        </div>
                    </div>

                    <div class="ip-journey-step-card">
                        <div class="ip-step-top">
                            <span class="ip-step-number-badge">5</span>
                            <span class="ip-badge ip-badge-ongoing">Live Room</span>
                        </div>
                        <div class="ip-step-content">
                            <h4 class="ip-step-title">Conduct Interview</h4>
                            <p class="ip-step-desc">WebRTC video, real-time Gemini AI follow-up questions, notes, and live transcript.</p>
                        </div>
                        <div class="ip-step-action">
                            <% if (interviews && interviews.length > 0 && interviews[0]._id) { %>
                                <a href="/interview-room/<%= interviews[0]._id %>" class="ip-btn ip-btn-primary ip-btn-sm ip-btn-block">
                                    Latest Room &rarr;
                                </a>
                            <% } else { %>
                                <a href="#interviewsSection" class="ip-btn ip-btn-secondary ip-btn-sm ip-btn-block">
                                    View Schedule &rarr;
                                </a>
                            <% } %>
                        </div>
                    </div>

                    <div class="ip-journey-step-card">
                        <div class="ip-step-top">
                            <span class="ip-step-number-badge">6</span>
                            <span class="ip-badge ip-badge-completed">Debrief</span>
                        </div>
                        <div class="ip-step-content">
                            <h4 class="ip-step-title">Evaluation & Reports</h4>
                            <p class="ip-step-desc">Score candidates 1–5, generate AI synthesis summaries, and export final reports.</p>
                        </div>
                        <div class="ip-step-action">
                            <% if (interviews && interviews.length > 0 && interviews[0]._id) { %>
                                <a href="/interview-room/<%= interviews[0]._id %>" class="ip-btn ip-btn-secondary ip-btn-sm ip-btn-block">
                                    Scorecards & AI &rarr;
                                </a>
                            <% } else { %>
                                <span class="ip-form-hint" style="text-align: center; display: block;">After interview</span>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Candidate End-to-End Journey Track (Hidden by default, shown when toggled) -->
                <div id="journeyCandidate" class="ip-journey-track" style="display: none;">
                    <div class="ip-journey-step-card">
                        <div class="ip-step-top">
                            <span class="ip-step-number-badge">1</span>
                            <span class="ip-badge ip-badge-open">Step 1</span>
                        </div>
                        <div class="ip-step-content">
                            <h4 class="ip-step-title">Browse Available Jobs</h4>
                            <p class="ip-step-desc">Explore open job listings, role descriptions, and required skill sets.</p>
                        </div>
                        <div class="ip-step-action">
                            <a href="/available-jobs" class="ip-btn ip-btn-primary ip-btn-sm ip-btn-block">
                                Browse Jobs &rarr;
                            </a>
                        </div>
                    </div>

                    <div class="ip-journey-step-card">
                        <div class="ip-step-top">
                            <span class="ip-step-number-badge">2</span>
                            <span class="ip-badge ip-badge-applied">Step 2</span>
                        </div>
                        <div class="ip-step-content">
                            <h4 class="ip-step-title">Apply & Upload Resume</h4>
                            <p class="ip-step-desc">Select a target role and upload your PDF resume to submit your application.</p>
                        </div>
                        <div class="ip-step-action">
                            <a href="/available-jobs" class="ip-btn ip-btn-secondary ip-btn-sm ip-btn-block">
                                Apply to Role &rarr;
                            </a>
                        </div>
                    </div>

                    <div class="ip-journey-step-card">
                        <div class="ip-step-top">
                            <span class="ip-step-number-badge">3</span>
                            <span class="ip-badge ip-badge-shortlisted">Step 3</span>
                        </div>
                        <div class="ip-step-content">
                            <h4 class="ip-step-title">Track Applications</h4>
                            <p class="ip-step-desc">Check your application status (*Applied &rarr; Shortlisted &rarr; Interview*).</p>
                        </div>
                        <div class="ip-step-action">
                            <a href="/my-applications" class="ip-btn ip-btn-secondary ip-btn-sm ip-btn-block">
                                My Applications &rarr;
                            </a>
                        </div>
                    </div>

                    <div class="ip-journey-step-card">
                        <div class="ip-step-top">
                            <span class="ip-step-number-badge">4</span>
                            <span class="ip-badge ip-badge-ongoing">Step 4</span>
                        </div>
                        <div class="ip-step-content">
                            <h4 class="ip-step-title">Join Video Interview</h4>
                            <p class="ip-step-desc">Enable camera & mic, connect with the interviewer, and speak with live speech-to-text.</p>
                        </div>
                        <div class="ip-step-action">
                            <a href="/my-applications" class="ip-btn ip-btn-primary ip-btn-sm ip-btn-block">
                                Join Interview &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Stats Overview -->
            <div class="ip-dashboard-stats">
                <div class="ip-stat-card">
                    <div class="ip-stat-icon ip-stat-icon-roles">
                        <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <div class="ip-stat-info">
                        <span class="ip-stat-label">Hiring Roles</span>
                        <span class="ip-stat-value"><%= (jobs && jobs.length) ? jobs.length : 0 %></span>
                    </div>
                </div>

                <div class="ip-stat-card">
                    <div class="ip-stat-icon ip-stat-icon-interviews">
                        <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <div class="ip-stat-info">
                        <span class="ip-stat-label">Your Interviews</span>
                        <span class="ip-stat-value"><%= (interviews && interviews.length) ? interviews.length : 0 %></span>
                    </div>
                </div>

                <div class="ip-stat-card">
                    <div class="ip-stat-icon ip-stat-icon-candidate">
                        <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                    <div class="ip-stat-info">
                        <span class="ip-stat-label">Candidate View</span>
                        <a href="/my-applications" class="ip-btn ip-btn-secondary ip-btn-sm" style="margin-top: 0.25rem;">My Applications</a>
                    </div>
                </div>
            </div>

            <!-- Two Column Dashboard Grid -->
            <div class="ip-dashboard-grid">

                <!-- Left Column: Active Hiring Roles -->
                <div class="ip-section">
                    <div class="ip-section-title-wrap">
                        <h2 class="ip-section-title">My Hiring Roles</h2>
                        <a href="/jobs" class="ip-btn ip-btn-secondary ip-btn-sm">View All Roles</a>
                    </div>

                    <div class="ip-card">
                        <% if (!jobs || jobs.length === 0) { %>
                            <div class="ip-empty-state">
                                <div class="ip-empty-icon">
                                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                                    </svg>
                                </div>
                                <h3 class="ip-empty-title">No hiring roles yet</h3>
                                <p class="ip-empty-description">Create your first role to start accepting applicants and scheduling interviews.</p>
                                <a href="/create-job" class="ip-btn ip-btn-primary ip-btn-sm">Create Hiring Role</a>
                            </div>
                        <% } else { %>
                            <div>
                                <% jobs.slice(0, 5).forEach(job => { %>
                                    <div class="ip-list-item">
                                        <div class="ip-item-main">
                                            <div class="ip-item-title"><%= job.title %></div>
                                            <p class="ip-item-meta" style="max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                <%= job.description %>
                                            </p>
                                        </div>
                                        <div class="ip-item-actions">
                                            <a href="/jobs/<%= job._id %>/applicants" class="ip-btn ip-btn-secondary ip-btn-sm">
                                                Applicants
                                            </a>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Right Column: Scheduled / Recent Interviews -->
                <div id="interviewsSection" class="ip-section">
                    <div class="ip-section-title-wrap">
                        <h2 class="ip-section-title">Your Interviews</h2>
                    </div>

                    <div class="ip-card">
                        <% if (!interviews || interviews.length === 0) { %>
                            <div class="ip-empty-state">
                                <div class="ip-empty-icon">
                                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                    </svg>
                                </div>
                                <h3 class="ip-empty-title">No interviews scheduled</h3>
                                <p class="ip-empty-description">Interviews scheduled for your hiring roles will show up here.</p>
                            </div>
                        <% } else { %>
                            <div>
                                <% interviews.forEach(interview => { %>
                                    <div class="ip-list-item">
                                        <div class="ip-item-main">
                                            <div class="ip-item-title"><%= interview.candidateName || "Candidate" %></div>
                                            <div class="ip-item-meta">
                                                <span><%= interview.position || "Position" %></span>
                                                <span>•</span>
                                                <span><%= interview.candidateEmail || "" %></span>
                                            </div>
                                        </div>
                                        <div class="ip-item-actions">
                                            <span class="ip-badge ip-badge-<%= interview.status %>"><%= interview.status %></span>
                                            <% if (interview._id) { %>
                                                <a href="/interview-room/<%= interview._id %>" class="ip-btn ip-btn-secondary ip-btn-sm">
                                                    Room
                                                </a>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>

            </div>

            <!-- Legacy Link Footer -->
            <div class="ip-legacy-link-box">
                <span>Advanced / Quick Direct Interview: </span>
                <a href="/create-interview">Direct Interview Setup</a>
            </div>

        </div>
    </main>

    <!-- Client-side Interactive Journey Switcher -->
    <script>
        function switchJourney(role) {
            const tabInterviewer = document.getElementById('tabInterviewer');
            const tabCandidate = document.getElementById('tabCandidate');
            const journeyInterviewer = document.getElementById('journeyInterviewer');
            const journeyCandidate = document.getElementById('journeyCandidate');

            if (role === 'candidate') {
                tabCandidate.classList.add('active');
                tabInterviewer.classList.remove('active');
                journeyCandidate.style.display = 'grid';
                journeyInterviewer.style.display = 'none';
            } else {
                tabInterviewer.classList.add('active');
                tabCandidate.classList.remove('active');
                journeyInterviewer.style.display = 'grid';
                journeyCandidate.style.display = 'none';
            }
        }
    </script>

</body>
</html>