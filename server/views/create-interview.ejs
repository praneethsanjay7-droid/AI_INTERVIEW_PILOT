<!DOCTYPE html>
<html>
<head>
    <title>Create Interview</title>
</head>
<body>

    <h1>Create Interview</h1>

    <form action="/create-interview" method="POST">

        <label>Candidate Name</label>
        <input
            type="text"
            name="candidateName"
            required
        >

        <br><br>

        <label>Candidate Email</label>
        <input
            type="email"
            name="candidateEmail"
            required
        >

        <br><br>

        <label>Position</label>
        <input
            type="text"
            name="position"
            placeholder="e.g. Software Developer"
            required
        >

        <br><br>

        <button type="submit">
            Create Interview
        </button>

    </form>

    <br>

    <a href="/dashboard">Back to Dashboard</a>

</body>
</html>